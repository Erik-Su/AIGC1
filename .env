APP_NAME=Anon Forge
APP_DESCRIPTION=Anon Forge
APP_ENV=development
HOST=127.0.0.1
PORT=8088
API_PREFIX=/api
OSS_ROOT=./data/oss

DB_ENGINE=postgresql
DB_DRIVER=psycopg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=anonforge
DB_USER=anonforge
DB_PASSWORD=anonforge
TZ=Asia/Shanghai

POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_CONTAINER_NAME=anonforge_dev_postgres
DB_PORT=5432

DB_DATA_PATH=./postgres/data
DB_HEALTHCHECK_INTERVAL=10s
DB_HEALTHCHECK_TIMEOUT=5s
DB_HEALTHCHECK_RETRIES=3